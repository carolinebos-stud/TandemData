name: Post JSON File to Two URLs
on:
push:
branches:
- main # Runs only when pushing to the main branch
workflow_dispatch: # Allows manual trigger
jobs:
post_json:
runs-on: ubuntu-latest
steps:
- name: Checkout Repository
uses: actions/checkout@v3
- name: Send JSON Data to First URL
run: |
curl -X POST "https://:c9FYCwNrRcmAybDAirmOfA@tandem.autodesk.com/api/v1/timeseries/models/urn:adsk.dtm:4ogcPbkuSw-SepL4eC-crg/streams/AQAAAO7_W_rI2k5hoXokBO6qy2QAAAAA" \
-H "Content-Type: application/json" \
-d @stream.json
- name: Send JSON Data to Second URL
run: |
curl -X POST "https://:bLN234VZTq6cmwkteOXxCg@tandem.autodesk.com/api/v1/timeseries/models/urn:adsk.dtm:4ogcPbkuSw-SepL4eC-crg/streams/AQAAAM1Xgln95kS0oDv6ZcVbrjsAAAAA" \
-H "Content-Type: application/json" \
-d @stream.json
          echo Add other actions to build,
          echo test, and deploy your project.
